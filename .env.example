# Twilio API Credentials
# Get these from: https://console.twilio.com

# Your Account SID (starts with AC...)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Key credentials (create at: https://console.twilio.com/user-settings/api-keys)
# API Keys are more secure than using your Auth Token
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret_here

# Your Twilio phone number (for receiving calls)
TWILIO_PHONE_NUMBER=+15551234567

# Optional: TwiML Application SID (for advanced routing)
# Create at: https://console.twilio.com/voice/twiml/applications
TWILIO_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx